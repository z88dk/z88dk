// block graphics
X("\\  ", 0x00, _WWWW)
X("\\' ", 0x01, _BWWW)
X("\\ '", 0x02, _WBWW)
X("\\''", 0x03, _BBWW)
X("\\. ", 0x04, _WWBW)
X("\\: ", 0x05, _BWBW)
X("\\.'", 0x06, _WBBW)
X("\\:'", 0x07, _BBBW)
X("\\##", 0x08, _GGGG)
X("\\,,", 0x09, _WWGG)
X("\\~~", 0x0a, _GGWW)
X("\\::", 0x80, _BBBB)
X("\\.:", 0x81, _WBBB)
X("\\:.", 0x82, _BWBB)
X("\\..", 0x83, _WWBB)
X("\\':", 0x84, _BBWB)
X("\\ :", 0x85, _WBWB)
X("\\'.", 0x86, _BWWB)
X("\\ .", 0x87, _WWWB)
X("\\@@", 0x88, _INV_GGGG)
X("\\;;", 0x89, _BBGG)
X("\\!!", 0x8a, _GGBB)

// white space
X(" ", 0x00, _SP)
X("% ", 0x80, _INV_SP)
X("\\T", 0x00, _SP)
X("\t", 0x00, _SP)

X("\\R", 0x76, _NL)
X("\\N", 0x76, _NL)
X("\\F", 0x76, _NL)
X("\\V", 0x76, _NL)
X("\r", 0x76, _NL)
X("\n", 0x76, _NL)
X("\f", 0x76, _NL)
X("\v", 0x76, _NL)

