X("Identifier", Identifier)
X("Float", Float)
X("Integer", Integer)
X("StringLiteral", StringLiteral)
X("CharConstant", CharConstant)
X("AsmOperator", AsmOperator)
X("!", Exclamation)
X("#", Hash)
X("$", Dollar)
X("%", Percent)
X("&", Ampersand)
X("(", LeftParen)
X(")", RightParen)
X("*", Multiply)
X("**", Power)
X("+", Plus)
X(",", Comma)
X("-", Minus)
X("/", Divide)
X(":", Colon)
X(";", Semicolon)
X("<", Less)
X("<=", LessEqual)
X("<>", NotEqual)
X("=", Equal)
X(">", Greater)
X(">=", GreaterEqual)
X("?", Question)
X("@", At)
X("\\", IntDivide)
X("OR", OR)
X("AND", AND)
X("MOD", MOD)
X("NOT", NOT)
