// ROM routines
X(PRINT_A,		0x0010)
X(KEYBOARD, 	0x02bb)
X(PLOT_UNPLOT, 	0x0baf+3)	// entry after call STK_TO_BC C=x, B=y
X(P_PLOT,       0x0c98)
X(P_UNPLOT,     0x0c9e)
X(PRINT_AT, 	0x08f5)		// B=row, C=col -> HL=addr
X(REPORT_B, 	0x0ead)

