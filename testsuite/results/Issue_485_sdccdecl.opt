




	INCLUDE "z80_crt0.hdr"


	SECTION	code_compiler

._func
	ld	hl,2	;const
	call	l_gcharspsp	;
	ld	hl,5	;const
	add	hl,sp
	call	l_gchar
	pop	de
	add	hl,de
	ret



._func2
	ld	bc,513
	push	bc
	call	_func
	pop	bc
	ret



._func3
	call	_compute
	ld	a,l
	call	l_sxt
	ld	(_a),hl
	ret



._func4
	call	_compute2
	ld	h,0
	ld	(_a),hl
	ret


	SECTION	bss_compiler
	SECTION	code_compiler



	SECTION	bss_compiler
	SECTION	code_compiler



	GLOBAL	_func
	GLOBAL	_func2
	GLOBAL	_a
	GLOBAL	_compute
	GLOBAL	_compute2
	GLOBAL	_func3
	GLOBAL	_func4



	defc	__fp_mode = 0
	defc	__fp_exponent_bias = 128
	defc	__fp_mantissa_size = 5
	IF	__fp_mode + __fp_exponent_bias + __fp_mantissa_size
	ENDIF

