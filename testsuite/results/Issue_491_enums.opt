




	INCLUDE "z80_crt0.hdr"


	SECTION	rodata_compiler
._g_noteEditMode
	defw	0
	SECTION	code_compiler

._main
	push	bc
	ld	hl,3	;const
	ld	(_g_noteEditMode),hl
	ld	hl,(_editedNoteStep)
	inc	hl
	pop	bc
	push	hl
	ld	hl,(_editedNoteStep)
	call	l_gint5	;
	pop	bc
	push	hl
	ld	hl,1	;const
	pop	bc
	ret


	SECTION	bss_compiler
	SECTION	code_compiler



	SECTION	bss_compiler
	SECTION	code_compiler



	GLOBAL	_g_noteEditMode
	GLOBAL	_editedNoteStep
	GLOBAL	_main



	defc	__fp_mode = 0
	defc	__fp_exponent_bias = 128
	defc	__fp_mantissa_size = 5
	IF	__fp_mode + __fp_exponent_bias + __fp_mantissa_size
	ENDIF

