




	INCLUDE "z80_crt0.hdr"


	SECTION	code_compiler

._callit
	pop	bc
	pop	hl
	push	hl
	push	bc
	ld	a,h
	or	l
	jp	z,i_2	;
	ld	hl,_func1
	jp	i_3	;
.i_2
	ld	hl,_func2
.i_3
	push	hl
	call	l_gint4sp	;
	ex	(sp),hl
	call	l_jphl
	pop	bc
	ret


	SECTION	bss_compiler
	SECTION	code_compiler



	SECTION	bss_compiler
	SECTION	code_compiler



	GLOBAL	_func1
	GLOBAL	_func2
	GLOBAL	_callit



	defc	__fp_mode = 0
	defc	__fp_exponent_bias = 128
	defc	__fp_mantissa_size = 5
	IF	__fp_mode + __fp_exponent_bias + __fp_mantissa_size
	ENDIF

