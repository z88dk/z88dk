




	INCLUDE "z80_crt0.hdr"


	SECTION	code_compiler

._func
	pop	bc
	pop	hl
	push	hl
	push	bc
	push	hl
	ld	hl,i_0+0
	push	hl
	pop	bc
	pop	bc
	ret



._main
	ld	hl,i_5+5
	push	hl
	call	_func
	pop	bc
	ret


	SECTION	bss_compiler
	SECTION	code_compiler

	SECTION	rodata_compiler
.i_1
	defm	"func"
	defb	0

	defm	"main"
	defb	0



	SECTION	bss_compiler
	SECTION	code_compiler



	GLOBAL	_func
	GLOBAL	_main



	defc	__fp_mode = 0
	defc	__fp_exponent_bias = 128
	defc	__fp_mantissa_size = 5
	IF	__fp_mode + __fp_exponent_bias + __fp_mantissa_size
	ENDIF

