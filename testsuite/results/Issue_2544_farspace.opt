




	INCLUDE "z80_crt0.hdr"


	SECTION	code_compiler

._array_degrade
	push	bc
	ld	hl,+(_arr % 65536)
	ld	de,+(_arr / 65536)
	call	l_far_mapaddr
	ld	bc,10
	add	hl,bc
	jr	nc,ASMPC+3
	inc	de
	push	de
	push	hl
	call	_func2
	pop	bc
	pop	bc
	pop	bc
	ret



._int_arith
	ld	hl,+(_i % 65536)
	ld	de,+(_i / 65536)
	call	l_far_mapaddr
	call	lp_gint
	ex	de,hl
	call	l_gint2sp
	add	hl,de
	ret



._int_ptr
	ld	hl,+(_i % 65536)
	ld	de,+(_i / 65536)
	call	l_far_mapaddr
	push	de
	push	hl
	call	_intfunc
	pop	bc
	pop	bc
	ret



._getptr
	ld	hl,+(_cptr % 65536)
	ld	de,+(_cptr / 65536)
	call	l_far_mapaddr
	call	lp_gint
	call	l_gchar
	ret



._return_intptr_arith
	ld	hl,+(_i % 65536)
	ld	de,+(_i / 65536)
	call	l_far_mapaddr
	ld	bc,4
	add	hl,bc
	jr	nc,ASMPC+3
	inc	de
	ret


	SECTION	bss_compiler
	SECTION	code_compiler



	SECTION	bss_compiler
	SECTION	code_compiler



	GLOBAL	_func2
	GLOBAL	_arr
	GLOBAL	_i
	GLOBAL	_cptr
	GLOBAL	_array_degrade
	GLOBAL	_int_arith
	GLOBAL	_intfunc
	GLOBAL	_int_ptr
	GLOBAL	_getptr
	GLOBAL	_return_intptr_arith



	defc	__fp_mode = 0
	defc	__fp_exponent_bias = 128
	defc	__fp_mantissa_size = 5
	IF	__fp_mode + __fp_exponent_bias + __fp_mantissa_size
	ENDIF

