




	INCLUDE "z80_crt0.hdr"


	SECTION	code_compiler

._main
	ld	hl,_main
	push	hl
	ld	hl,1	;const
	ld	de,0
	push	de
	push	hl
	ld	hl,3	;const
	push	hl
	call	_function
	pop	bc
	pop	bc
	pop	bc
	pop	bc
	ret


	SECTION	bss_compiler
	SECTION	code_compiler



	SECTION	bss_compiler
	SECTION	code_compiler



	GLOBAL	_function
	GLOBAL	_main



	defc	__fp_mode = 0
	defc	__fp_exponent_bias = 128
	defc	__fp_mantissa_size = 5
	IF	__fp_mode + __fp_exponent_bias + __fp_mantissa_size
	ENDIF

