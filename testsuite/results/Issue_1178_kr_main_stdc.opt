




	INCLUDE "z80_crt0.hdr"


	SECTION	code_compiler

._main
	pop	bc
	pop	hl
	push	hl
	push	bc
	push	hl
	call	_func
	pop	bc
	call	l_gint4sp	;
	call	l_gint2	;
	push	hl
	call	_func2
	pop	bc
	ret



._func3
	call	l_gint4sp	;
	push	hl
	call	_func
	pop	bc
	pop	bc
	pop	hl
	push	hl
	push	bc
	call	l_gint2	;
	push	hl
	call	_func2
	pop	bc
	ret


	SECTION	bss_compiler
	SECTION	code_compiler



	SECTION	bss_compiler
	SECTION	code_compiler



	GLOBAL	_func
	GLOBAL	_func2
	GLOBAL	_main
	GLOBAL	_func3



	defc	__fp_mode = 0
	defc	__fp_exponent_bias = 128
	defc	__fp_mantissa_size = 5
	IF	__fp_mode + __fp_exponent_bias + __fp_mantissa_size
	ENDIF

