




	INCLUDE "z80_crt0.hdr"


	SECTION	code_compiler

._test1
	ld	hl,_func_fcall
	push	hl
	push	hl
	ld	hl,1	;const
	pop	af
	ld	bc,i_2
	push	bc
	push	af
	ret
.i_2
	pop	bc
	ret



._test2
	ld	hl,_func
	push	hl
	ld	bc,1	;const
	push	bc
	call	l_jphl
	pop	bc
	pop	bc
	ret



._test3
	ld	hl,_func_callee
	push	hl
	ld	bc,1	;const
	push	bc
	call	l_jphl
	pop	bc
	ret


	SECTION	bss_compiler
	SECTION	code_compiler



	SECTION	bss_compiler
	SECTION	code_compiler



	GLOBAL	_func_fcall
	GLOBAL	_func
	GLOBAL	_func_callee
	GLOBAL	_test1
	GLOBAL	_test2
	GLOBAL	_test3



	defc	__fp_mode = 0
	defc	__fp_exponent_bias = 128
	defc	__fp_mantissa_size = 5
	IF	__fp_mode + __fp_exponent_bias + __fp_mantissa_size
	ENDIF

