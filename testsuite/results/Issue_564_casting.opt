




	INCLUDE "z80_crt0.hdr"


	SECTION	code_compiler

._func3
	pop	bc
	pop	hl
	push	hl
	push	bc
	call	l_gint	;
	call	l_int2long_s
	ret



._func2
	pop	bc
	pop	hl
	push	hl
	push	bc
	call	l_gint2	;
	push	hl
	call	_value
	pop	bc
	ret



._func
	pop	bc
	pop	hl
	push	hl
	push	bc
	call	l_gint2	;
	push	hl
	call	_value
	pop	bc
	ret



._func4
	ld	hl,(_item+2)
	push	hl
	call	_value
	pop	bc
	ret



._func5
	ld	hl,(_item)
	call	l_int2long_s
	ret


	SECTION	bss_compiler
	SECTION	code_compiler



	SECTION	bss_compiler
._item	defs	6
	SECTION	code_compiler



	GLOBAL	_value
	GLOBAL	_func3
	GLOBAL	_func2
	GLOBAL	_func
	GLOBAL	_item
	GLOBAL	_func4
	GLOBAL	_func5



	defc	__fp_mode = 0
	defc	__fp_exponent_bias = 128
	defc	__fp_mantissa_size = 5
	IF	__fp_mode + __fp_exponent_bias + __fp_mantissa_size
	ENDIF

