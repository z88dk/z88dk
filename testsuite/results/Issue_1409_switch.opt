




	INCLUDE "z80_crt0.hdr"


	SECTION	code_compiler

._func
	pop	bc
	pop	hl
	push	hl
	push	bc
.i_4
	call	l_case
	defw	i_5
	defw	1
	defw	i_6
	defw	3
	defw	0
	ret
.i_5
	ld	hl,1	;const
	push	hl
	call	_dofunc
	pop	bc
	ret
.i_6
	ld	hl,1	;const
	push	hl
	call	_dofunc
	pop	bc
.i_3
	ret


	SECTION	bss_compiler
	SECTION	code_compiler



	SECTION	bss_compiler
	SECTION	code_compiler



	GLOBAL	_dofunc
	GLOBAL	_func



	defc	__fp_mode = 0
	defc	__fp_exponent_bias = 128
	defc	__fp_mantissa_size = 5
	IF	__fp_mode + __fp_exponent_bias + __fp_mantissa_size
	ENDIF

