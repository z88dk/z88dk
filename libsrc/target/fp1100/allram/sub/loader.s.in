; Stage 1: runs from VRAM at $3A60 (placed there with the ROM's "define character" command),
; receives the first page (SUB_P1END - SUB_MAIN bytes) into SUB_MAIN (VRAM, sent inverted) and jumps to it.  sub.inc is the sub program's define file.
        INCLUDE "sub.inc"
        ORG $3A60
L0:     DI
        LXI SP,0
        LXI HL,SUB_MAIN
        MVI C,SUB_P1END-SUB_MAIN-1
L1:     CALL RcvL
        STAX HL+
        DCR C
        JR L1
        JMP SUB_MAIN
RcvL:   MVI E,$80
        MOV $E800,E
RwL:    SKIT F2
        JR RwL
        MOV A,$E800
        MVI E,0
        MOV $E800,E
        RET
