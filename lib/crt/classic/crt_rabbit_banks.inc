; Rabbit code banks, for #pragma bank N and __banked.
;
; Bank N is an 8k page seen in the XPC window (logical 0xE000-0xFFFF) with
; XPC = N * 2, which is physical 0x10000 + (N - 1) * 0x2000: the banks follow
; the 64k root image contiguously. Bank 0 is the root image, so banks start at 1.
; z80asm keeps the bank number in the address bits above 16.
;
; The window is also the top of the near address space: the stack and all
; data must sit below 0xE000, or they move with XPC. Far pointers use the same
; window, so set CRT_RABBIT_BANKS=0 for far pointers without code banks.
;
; Include after crt_section.inc. Nothing is emitted unless
; CRT_RABBIT_BANKS (the number of banks) is set. Bank N is at physical
; N * 0x2000 + 0xE000, so a Rabbit 2000 or 3000 (1MB) has banks 1 to 120.
; The Rabbit 4000 and later (16MB) have banks 1 to 2040, with a 12-bit LXPC.
; CRT_ORG_BANK_nn (hex nn) overrides the logical origin of a bank.
; Banks 1 to 255 are written out here because sections cannot be generated by
; macro. For a higher bank, define the sections in your own file: SECTION
; BANK_nnn with org nnn0000 + 0xE000, then SECTION CODE_n and RODATA_n (n is
; decimal).

IFDEF CRT_RABBIT_BANKS
  IF CRT_RABBIT_BANKS >= 1
    IFNDEF CRT_ORG_BANK_01
      defc CRT_ORG_BANK_01 = 0xE000
    ENDIF
    SECTION BANK_01
    org $010000 + CRT_ORG_BANK_01
    SECTION CODE_1
    SECTION RODATA_1
  ENDIF
  IF CRT_RABBIT_BANKS >= 2
