; Olivetti M10 firmware macros and defs
;
; M100 system ROM aka firmware can be called in atleast a couple of ways
; If we're calling it from OPTROM made with Stephen Adolph's template, we do
; RST 6; DEFW ROM_ADDR
; And if we're calling from normal RAM, then we simply do CALL ROM_ADDR

; With ROMCALL macro, all ROM calls (except RSTs) can be abstracted into
; ROMCALL; DEFW ROM_ADDR
; ...and be conditionally compiled depending on the subtype we use.

    EXTERN  ROMCALL_OP ; it's defined in m100_crt0.asm
#define ROMCALL defb ROMCALL_OP

; ROM calls:

#define OPTROM_SIG "AB"
defc    CONSOLE_ROWS = 8

defc    KY_POPAFRET = $26A1
defc    OPTROMSIG = $FAAB

defc    KY_KYREAD  = $12D4 ; wait for key from the keyboard
defc    KY_KYPEND  = $13E4 ; check keyboard queue for pending characters

defc    KY_CLS = $420D ; clear screen
;defc    KY_CHROUT  = $4B12 ; print character in reg. A to LCD/printer
;defc    KY_CURPOS  = $4258 ; position cursor; H=column (1-40), L=row(1-8)
defc    KY_CURSON  = $4225 ; turn cursor on
defc    KY_CURSOFF = $422A ; ...and off
;defc    KY_BEEP    = $4205 ; sound the beeper

;defc    KY_CSRX    = $F640
;defc    KY_CSRY    = $F641
;defc    KY_LCDSET  = $7166 ; LCD set pixel (D, E)
;defc    KY_LCDRES  = $7167 ; LCD reset pixel (D, E)

defc    KY_SHAPE              = $FF90

defc    KY_SETINT_1D          = $7376
defc    KY_SET_LCD_ADDR       = $7255
defc    KY_GET_LCD            = $720F
defc    KY_PLOT_TBL           = $735D
defc    KY_PLOT_TBL2          = $7367
defc    KY_LCDSET_TAIL        = KY_GET_LCD-$5D
