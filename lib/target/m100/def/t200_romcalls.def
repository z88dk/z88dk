; T200 firmware macros and defs
;
; Values mapped from m100 using:
; https://ftp.whtech.com/club100/ref/equate.200
; via: http://www.club100.org/library/libref.html

    EXTERN  ROMCALL_OP ; it's defined in m100_crt0.asm
#define ROMCALL defb ROMCALL_OP

; ROM calls:

#define OPTROM_SIG "TC"
defc    CONSOLE_ROWS = 16

defc    KY_POPAFRET = $1533
defc    OPTROMSIG = $FAA4       ;XX - need to find

defc    KY_KYREAD  = $12f7 ; wait for key from the keyboard
defc    KY_KYPEND  = $140a ; check keyboard queue for pending characters

defc    KY_CLS     = $4f4d ; clear screen
;defc    KY_CHROUT  = $5a05 ; print character in reg. A to LCD/printer
;defc    KY_CURPOS  = $4f9b ; position cursor; H=column (1-40), L=row(1-16)
defc    KY_CURSON  = $4f68 ; turn cursor on
defc    KY_CURSOFF = $4f6d ; ...and off
;defc    KY_BEEP    = $4f45 ; sound the beeper

;defc    KY_CSRX    = $EF06
;defc    KY_CSRY    = $EF07

;defc    KY_LCDSET  = $8d76 ; LCD set pixel (D, E)
;defc    KY_LCDRES  = $8d77 ; LCD reset pixel (D, E)

defc    SHAPE              = $0

; The T200 display is different !
defc    KY_SETINT_1D          = $8fa0
defc    KY_SET_LCD_ADDR       = $0
defc    KY_GET_LCD            = $0
defc    KY_PLOT_TBL           = $0
defc    KY_PLOT_TBL2          = $0
defc    KY_LCDSET_TAIL        = $0

