lstoff

; SD Card common definitions

; $Id: sdcard.def,v 1.3 2012-09-21 14:02:22 stefano Exp $
;	Modified November 2026 feilipu.


	defc	sd_error_spi_mode_failed	= $01

	defc	sd_error_mmc_init_failed	= $10
	defc	sd_error_sd_init_failed		= $11
	defc	sd_error_sdhc_init_failed	= $12
	defc	sd_error_vrange_bad			= $13
	defc	sd_error_check_pattern_bad	= $14

	defc	sd_error_illegal_command		= $20
	defc	sd_error_bad_command_response	= $21
	defc	sd_error_data_token_timeout		= $22
	defc	sd_error_write_timeout			= $23
	defc	sd_error_write_failed			= $24
	defc	sd_error_too_big				= $25


; SPI command byte. Bits 5-0 are the command index. Bit 6 is set.
; An ACMD is that byte sent after CMD55. The card clears APP_CMD on it.
; The same byte is CMD23 or ACMD23. CMD55 decides which one runs.
;
; R1 is one status byte. Bit 7 set means the byte is not R1. $FF is delay.
; R1b is R1, then busy ($00) until the line reads $FF.
; R2 is two status bytes (CMD13). This driver does not read R2.
; R3 is R1 plus the 32-bit OCR (CMD58). OCR bit 31 is power-up. Bit 30 is CCS.
; R7 is R1 plus 32 bits (CMD8). The echo is the voltage and the check pattern.
; A data response is a separate byte after a write block. Its low 5 bits are $05
; when the block was accepted. CRC and write errors use other status bits.

	defc	R1_IDLE			= $01
	defc	R1_ERASE_RESET		= $02
	defc	R1_ILLEGAL		= $04
	defc	R1_CRC			= $08
	defc	R1_ERASE_SEQ		= $10
	defc	R1_ADDRESS		= $20
	defc	R1_PARAMETER		= $40

	defc	TOKEN_DATA		= $FE	; single-block read or write
	defc	TOKEN_MULTI		= $FC	; one block of a multi-block write
	defc	TOKEN_STOP		= $FD	; end a multi-block write
	defc	TOKEN_ACCEPTED		= $05	; write data response, low 5 bits

	defc	CMD0			= $40	; GO_IDLE_STATE. R1. Idle is R1_IDLE.
	defc	SD_GO_IDLE_STATE	= $40

	defc	CMD1			= $41	; SEND_OP_COND. MMC. R1. Ready is $00.
	defc	SD_SEND_OP_COND		= $41

	defc	CMD8			= $48	; SEND_IF_COND. R7 when the command is legal.

	defc	CMD9			= $49	; SEND_CSD. R1, then TOKEN_DATA.
	defc	CMD10			= $4A	; SEND_CID. R1, then TOKEN_DATA.

	defc	CMD12			= $4C	; STOP_TRANSMISSION. R1b. One stuff byte, then R1.
	defc	SD_TERMINATE_MULTI_READ	= $4C

	defc	CMD13			= $4D	; SEND_STATUS. R2.
	defc	SD_STATUS		= $4D

	defc	CMD16			= $50	; SET_BLOCKLEN. R1. Byte-addressed cards only.
	defc	SD_SET_BLOCK_SIZE	= $50

	defc	CMD17			= $51	; READ_SINGLE_BLOCK. R1, then TOKEN_DATA.
	defc	MMC_READ_SINGLE_BLOCK	= $51

	defc	CMD18			= $52	; READ_MULTIPLE_BLOCK. R1, then one token per block.
	defc	SD_READ_MULTIPLE_BLOCK	= $52

	defc	CMD23			= $57	; SET_BLOCK_COUNT. R1. Same byte as ACMD23.
	defc	SD_SET_BLOCK_COUNT	= $57
	defc	ACMD23			= $57	; SET_WR_BLK_ERASE_COUNT. R1. Send CMD55 first.

	defc	CMD24			= $58	; WRITE_BLOCK. R1, then TOKEN_DATA, then data response.
	defc	SD_WRITE_SINGLE_BLOCK	= $58

	defc	CMD25			= $59	; WRITE_MULTIPLE_BLOCK. R1, then TOKEN_MULTI per block.
	defc	SD_WRITE_MULTIPLE_BLOCK	= $59

	defc	SD_START_TAG		= $60
	defc	SD_END_TAG		= $61
	defc	SD_ERASE_BLOCK		= $66

	defc	CMD55			= $77	; APP_CMD. R1. The next command is an ACMD.
	defc	ACMD41			= $69	; SD_SEND_OP_COND. R1. Argument bit 30 is HCS.

	defc	CMD58			= $7A	; READ_OCR. R3. CCS selects SDHC and SDXC addressing.
	defc	CMD59			= $7B	; CRC_ON_OFF. R1. Not sent. SPI CRC stays off.

	defc	MMC_STOP_TRAN		= $FD


lston

